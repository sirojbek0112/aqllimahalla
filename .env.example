# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JWT authentication tokens.
JWT_SECRET="aqllimahalla-change-this-secret-in-production"

# DATABASE_PATH: SQLite database file path
DATABASE_PATH="./data/aqllimahalla.db"

# VITE_API_URL: Optional backend origin if frontend is deployed separately (e.g. Netlify + Render)
VITE_API_URL=""
